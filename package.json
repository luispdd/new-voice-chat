{
  "name": "voice-chat-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "bunx nx serve frontend",
    "build": "bunx nx build frontend",
    "test": "bunx nx test frontend",
    "backend": "PYTHONPATH=. uv run --project apps/backend python3 apps/backend/main.py",
    "backend:dev": "PYTHONPATH=. uv run --project apps/backend python3 apps/backend/main.py --reload",
    "docker:up": "docker compose up -d mongodb",
    "docker:down": "docker compose down"
  },
